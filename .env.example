# ─── General ─────────────────────────────
NODE_ENV=development

# ─── API ─────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0

# ─── Database ────────────────────────────
# The `postgres` hostname resolves inside the Docker network.
# For direct host access, use `localhost` instead.
POSTGRES_USER=reservio
POSTGRES_PASSWORD=reservio
POSTGRES_DB=reservio
DATABASE_URL=postgresql://reservio:reservio@postgres:5432/reservio

# ─── Redis ───────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Access token (EdDSA) ────────────────
# DO NOT commit real keys. Generate a DEVELOPMENT-ONLY Ed25519 key pair:
#
#   node -e "const c=require('crypto');const{privateKey,publicKey}=c.generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}));"
#
# Then paste the PEM contents as single-line strings with literal \n:
#   ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#   ACCESS_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
#
# These are DEVELOPMENT-ONLY. Never use them in production.
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_PUBLIC_KEY=
JWT_ISSUER=reservio
JWT_AUDIENCE=reservio-api

# ─── Worker ──────────────────────────────
WORKER_CONCURRENCY=5