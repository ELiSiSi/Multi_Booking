# ─── General ─────────────────────────────────
NODE_ENV=development

# ─── API ─────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0

# ─── Database ────────────────────────────────
POSTGRES_USER=reservio
POSTGRES_PASSWORD=reservio
POSTGRES_DB=reservio
DATABASE_URL=postgresql://reservio:reservio@localhost:5433/reservio
# For Docker-internal:   postgresql://reservio:reservio@postgres:5432/reservio

# ─── Redis ───────────────────────────────────
# Same rule as DATABASE_URL:
#   (A) Docker-internal → redis://redis:6379
#   (B) Host access      → redis://localhost:6380
REDIS_URL=redis://localhost:6380
# For Docker-internal:   redis://redis:6379

# ─── Access token (EdDSA) ────────────────────

ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_PUBLIC_KEY=
JWT_ISSUER=reservio
JWT_AUDIENCE=reservio-api

# ─── Worker ──────────────────────────────────
WORKER_CONCURRENCY=5