{
  "name": "reservio",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-business booking platform — monorepo",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @reservio/api dev",
    "dev:worker": "pnpm --filter @reservio/worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:config": "vitest run packages/config",
    "test:shared": "vitest run packages/shared",
    "test:database": "vitest run packages/database",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:concurrency": "vitest run tests/concurrency",
    "test:regression": "vitest run tests/regression",
    "db:migrate": "pnpm --filter @reservio/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @reservio/database migrate:deploy",
    "db:migrate:reset": "pnpm --filter @reservio/database migrate:reset",
    "db:seed": "pnpm --filter @reservio/database seed",
    "db:generate": "pnpm --filter @reservio/database generate",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}