generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Phase 1: minimal schema — User + Business only.
// Additional models are added in later phases.
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  role         Role       @default(customer)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  businesses   Business[]

  @@map("User")
}

enum Role {
  admin
  customer
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Business {
  id     String         @id @default(uuid()) @db.Uuid
  ownerId String        @db.Uuid
  name   String
  status BusinessStatus @default(ACTIVE)

  // Scheduling policy (used in later phases)
  timezone                  String @default("UTC")
  slotGranularityMinutes    Int    @default(15)
  defaultBufferMinutes      Int    @default(0)
  pendingTimeoutMinutes     Int    @default(15)
  cancellationWindowMinutes Int    @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("Business")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}